# Copy this file to `.env` and adjust. `.env` is git-ignored; never commit real secrets.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
# Comma separated. Use your PC's LAN IP here when testing from a real phone.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
# Comma separated origins for browser clients (the mobile app does not need CORS).
CORS_ALLOWED_ORIGINS=

# MySQL / MariaDB (XAMPP defaults shown)
DB_NAME=volvo
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Google sign-in: comma-separated OAuth client IDs (the Web client ID from Firebase, plus the Android one).
GOOGLE_CLIENT_IDS=

# Password-reset emails. `console` prints them in the server terminal; use `smtp` with the EMAIL_* values in production.
EMAIL_MODE=console
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Volvo <no-reply@volvo.local>
